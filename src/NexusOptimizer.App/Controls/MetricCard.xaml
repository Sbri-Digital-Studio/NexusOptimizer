<UserControl x:Class="NexusOptimizer.App.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
             xmlns:s="clr-namespace:NexusOptimizer.App.Services">
    <UserControl.Resources>
        <s:BoolToVisibilityConverter x:Key="CardBoolVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="15,11" MinHeight="138">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="48" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{Binding CardTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"
                       FontWeight="SemiBold" Typography.Capitals="AllSmallCaps" VerticalAlignment="Top" />

            <!-- Indicatore: anello percentuale oppure valore singolo (rete/processi) -->
            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <c:RadialGauge Width="62" Height="62" RingThickness="5.5"
                               Value="{Binding CardProgress, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CenterText="{Binding CardValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               SubText="{Binding CardCaption, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Accent="{Binding CardAccent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               AnimationsEnabled="{Binding CardAnimationsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Visibility="{Binding CardShowGauge, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.Name="{Binding CardTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CardShowGauge, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding CardValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="27"
                               FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" />
                    <!-- La didascalia sotto il numero esiste solo senza anello: con
                         l'anello viene già disegnata al centro dal RadialGauge. -->
                    <TextBlock Text="{Binding CardCaption, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Margin="1,1,0,0" FontSize="9"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Righe chiave/valore: solo misure reali, "n.d." dove Windows non espone il dato -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                <Grid Margin="0,0,0,7">
                    <TextBlock Text="{Binding CardStat1Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="10.5" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding CardStat1Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
                <Grid Margin="0,0,0,7">
                    <TextBlock Text="{Binding CardStat2Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="10.5" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding CardStat2Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
                <!-- Riempimento della seconda riga: oggi la VRAM, che altrimenti
                     resterebbe due numeri da confrontare a mente. -->
                <ProgressBar Height="4" Margin="0,-3,0,7" Minimum="0" Maximum="100"
                             Value="{Binding CardStat2Progress, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue=0}"
                             Visibility="{Binding CardStat2HasProgress, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource CardBoolVis}}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border CornerRadius="2" Background="{DynamicResource HoverBrush}">
                                <Grid x:Name="PART_Track">
                                    <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left">
                                        <!-- CardAccent e' un Color: il pennello si costruisce qui. -->
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding CardAccent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <Grid>
                    <TextBlock Text="{Binding CardStat3Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="10.5" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding CardStat3Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <!-- Colore di stato opzionale: senza CardStat3Brush si segue il
                                 testo primario del tema corrente, anche dopo un cambio tema. -->
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{Binding CardStat3Brush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CardStat3Brush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{x:Null}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <c:SparkGraph Grid.Row="2" Grid.ColumnSpan="2" Height="30" VerticalAlignment="Bottom" Margin="0,7,0,0"
                          Smooth="True"
                          Series="{Binding CardSeries, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          FixedMax="{Binding CardFixedMax, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                          Unit="{Binding CardUnit, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                          WindowSeconds="{Binding CardWindowSeconds, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                          ShowYAxis="{Binding CardShowAxes, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                          ShowXAxis="{Binding CardShowAxes, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                          Accent="{Binding CardAccent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
    </Border>
</UserControl>
