<UserControl x:Class="NexusOptimizer.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DiagnosticResultButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ResultBackground" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResultBackground" Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="ResultBackground" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ResultBackground" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ResultBackground" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding PageSubtitle}" FontSize="13" Margin="1,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <Border Margin="0,18,0,0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,10">
                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.78*" />
                    <ColumnDefinition Width="1.22*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="13" Padding="22,18"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="PC HEALTH SCORE" FontSize="11" Typography.Capitals="AllSmallCaps"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="{Binding ScoreText}" FontSize="46" FontWeight="SemiBold"
                                       Foreground="{Binding ScoreBrush}" />
                            <TextBlock Text="{Binding ScoreSuffix}" FontSize="16" Margin="5,25,0,0"
                                       Foreground="{Binding ScoreBrush}" Opacity="0.78" />
                        </StackPanel>
                        <TextBlock Text="{Binding ScoreDetail}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="16,0,0,0" Background="{DynamicResource CardBrush}" CornerRadius="13"
                        Padding="20,17" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding FactorsTitle}" FontSize="11" Typography.Capitals="AllSmallCaps"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Factors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DiagnosticResultButton}" Margin="0,1"
                                            Click="ResultButton_Click"
                                            Command="{Binding DataContext.SelectFactorCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding DataContext.ResultClickHint,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,7,0"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="14,3,10,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ScoreText}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{Binding StateBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding StateText}" FontSize="9.5" Margin="0,2,0,0"
                                                           Foreground="{Binding StateBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Il dettaglio è immediatamente sotto i fattori: il click lo porta in vista e gli dà focus. -->
            <Border x:Name="SelectedResultPanel" Focusable="True" Margin="0,12,0,0"
                    Background="{DynamicResource AccentSoftBrush}" CornerRadius="11"
                    BorderBrush="{Binding SelectedResultBrush}" BorderThickness="1" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedResultLabel}" FontSize="9.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SelectedResultTitle}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{Binding SelectedResultBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SelectedResultDetail}" FontSize="10.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,16,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedResultMeta}" FontSize="10.5"
                               Foreground="{Binding SelectedResultBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="13" Padding="20,17"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding RecommendationsTitle}" FontSize="11" Typography.Capitals="AllSmallCaps"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DiagnosticResultButton}" Margin="0,1"
                                            Click="ResultButton_Click"
                                            Command="{Binding DataContext.SelectRecommendationCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding DataContext.ResultClickHint,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="15,3,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="16,0,0,0" Background="{DynamicResource CardBrush}" CornerRadius="13"
                        Padding="20,17" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding CrashesTitle}" FontSize="11" Typography.Capitals="AllSmallCaps"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding CrashStatus}" FontSize="11" Margin="0,6,0,8"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="55" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CrashDateLabel}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding CrashSourceLabel}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding CrashEventLabel}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CrashEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DiagnosticResultButton}" Padding="0,4" Margin="0"
                                            Click="ResultButton_Click"
                                            Command="{Binding DataContext.SelectCrashCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding DataContext.ResultClickHint,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="125" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="55" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DateText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding EventId}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,16,0,0" Background="{DynamicResource CardBrush}" CornerRadius="13" Padding="16,13"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding FormulaText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PrivacyNote}" FontSize="10.5" Margin="0,5,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
