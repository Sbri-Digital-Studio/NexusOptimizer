<UserControl x:Class="NexusOptimizer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
             xmlns:s="clr-namespace:NexusOptimizer.App.Services">
    <UserControl.Resources>
        <s:LocaleKeyConverter x:Key="Loc" />
        <s:BoolToVisibilityConverter x:Key="BoolVis" />
        <s:HexToBrushConverter x:Key="Hex" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left">
            <!-- Intestazione: dove sono, come esco, e se la modifica è stata salvata. -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.title}" />
                    <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="620"
                               HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.autosave}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Width="Auto" HorizontalAlignment="Right"
                            Command="{Binding DataContext.CloseSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.close}" />
                    <Border Margin="0,10,0,0" Padding="10,6" CornerRadius="9" HorizontalAlignment="Right"
                            Background="{DynamicResource CardBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource StateGreenBrush}"
                            Visibility="{Binding JustSaved, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <c:NxIcon Kind="check" Width="13" Height="13" Margin="0,0,7,0"
                                      Foreground="{DynamicResource StateGreenBrush}" />
                            <TextBlock Text="{Binding SavedLabel}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="24,18"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <c:NxIcon Kind="moon" Width="14" Height="14" Margin="0,0,9,0"
                                  VerticalAlignment="Center" Foreground="#B79CFF" />
                        <TextBlock FontSize="11" Typography.Capitals="AllSmallCaps" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.appearance}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.theme}" />
                        <ComboBox Grid.Column="1" Width="260" HorizontalAlignment="Left"
                                  Style="{StaticResource FieldComboBox}"
                                  ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding ThemeIndex}" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.accent}" />
                        <ListBox Grid.Column="1" ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent}"
                                 Background="Transparent" BorderThickness="0" HorizontalAlignment="Left">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                    <Setter Property="Padding" Value="3"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="AccentRing" CornerRadius="999"
                                                        Padding="{TemplateBinding Padding}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="AccentRing" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="AccentRing" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="22" Height="22" ToolTip="{Binding Name}"
                                             Fill="{Binding Hex, Converter={StaticResource Hex}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.language}" />
                        <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                  Style="{StaticResource FieldComboBox}"
                                  ItemsSource="{Binding LanguageOptions}" SelectedIndex="{Binding LanguageIndex}" />
                    </Grid>
                    <CheckBox Margin="0,18,0,0" IsChecked="{Binding Animations}" Style="{StaticResource QuickToggle}"
                              Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.animations}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                </StackPanel>
            </Border>

            <!-- COMPORTAMENTO -->
            <Border Margin="0,16,0,0" Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="24,18"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <c:NxIcon Kind="gear" Width="14" Height="14" Margin="0,0,9,0"
                                  VerticalAlignment="Center" Foreground="#57C7FF" />
                        <TextBlock FontSize="11" Typography.Capitals="AllSmallCaps" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.behavior}" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding StartWithWindows}" Style="{StaticResource QuickToggle}"
                              ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.startwithwin.tip}"
                              Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.startwithwin}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                    <TextBlock Text="{Binding StatusLine}" FontSize="11" Opacity="0.8" Margin="0,7,50,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <CheckBox Margin="0,16,0,0" IsChecked="{Binding MinimizeToTray}" Style="{StaticResource QuickToggle}"
                              Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.mintotray}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                    <Grid Margin="0,18,0,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.monitor.interval}" />
                        <ComboBox Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                  Style="{StaticResource FieldComboBox}"
                                  ItemsSource="{Binding MonitorIntervals}" SelectedIndex="{Binding MonitorIntervalIndex}" />
                    </Grid>
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.monitor.interval.hint}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                               MaxWidth="600" HorizontalAlignment="Left" Margin="0,7,0,0" />
                    <CheckBox Margin="0,16,0,0" IsChecked="{Binding LiveMonitoring}" Style="{StaticResource QuickToggle}"
                              Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.live}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                    <CheckBox Margin="0,16,0,0" IsChecked="{Binding QuietMode}" Style="{StaticResource QuickToggle}"
                              Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.quiet}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                    <StackPanel Margin="0,16,0,0">
                        <CheckBox IsChecked="{Binding AutoSafeClean}" Style="{StaticResource QuickToggle}"
                                  Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.autoclean}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                        <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.autoclean.hint}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,5,0,0" />
                        <Button Style="{StaticResource GhostButton}" Width="Auto" HorizontalAlignment="Left" Margin="24,9,0,0"
                                Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.autoclean.previewbtn}"
                                Command="{Binding PreviewAutoCleanCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AVVISI -->
            <Border Margin="0,16,0,0" Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="24,18"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <c:NxIcon Kind="bell" Width="14" Height="14" Margin="0,0,9,0"
                                  VerticalAlignment="Center" Foreground="#FFB454" />
                        <TextBlock FontSize="11" Typography.Capitals="AllSmallCaps" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.notifications}" />
                    </StackPanel>
                    <TextBlock FontSize="11.5" Opacity="0.8" Margin="0,6,0,14" TextWrapping="Wrap" MaxWidth="620"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.notify.hint}" />
                    <CheckBox IsChecked="{Binding NotifyLowDisk}" Style="{StaticResource QuickToggle}"
                              Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.notify.lowdisk}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                    <Grid Margin="24,12,0,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.notify.lowdisk.threshold}" />
                        <ComboBox Grid.Column="1" Width="110" HorizontalAlignment="Left"
                                  Style="{StaticResource FieldComboBox}"
                                  IsEnabled="{Binding NotifyLowDisk}"
                                  ItemsSource="{Binding LowDiskThresholds}" SelectedIndex="{Binding LowDiskThresholdIndex}" />
                    </Grid>
                    <CheckBox Margin="0,16,0,0" IsChecked="{Binding NotifyRecoverableSpace}" Style="{StaticResource QuickToggle}"
                              Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.notify.recover}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                    <CheckBox Margin="0,16,0,0" IsChecked="{Binding TemperatureAlerts}" Style="{StaticResource QuickToggle}"
                              Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.notify.temp}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                    <CheckBox Margin="0,16,0,0" IsChecked="{Binding StartupMonitoring}" Style="{StaticResource QuickToggle}"
                              Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.notify.startup}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                </StackPanel>
            </Border>

            <!-- AGGIORNAMENTI -->
            <Border Margin="0,16,0,0" Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="24,18"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <c:NxIcon Kind="rocket" Width="14" Height="14" Margin="0,0,9,0"
                                  VerticalAlignment="Center" Foreground="#6BD93D" />
                        <TextBlock FontSize="11" Typography.Capitals="AllSmallCaps" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.updates}" />
                    </StackPanel>
                    <TextBlock FontSize="11.5" Opacity="0.8" Margin="0,6,0,14" TextWrapping="Wrap" MaxWidth="620"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.updates.hint}" />
                    <CheckBox IsChecked="{Binding CheckForUpdates}" Style="{StaticResource QuickToggle}"
                              Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.updates.enable}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                    <Grid Margin="24,14,0,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.updates.url}" />
                        <TextBox Grid.Column="1" Width="360" HorizontalAlignment="Left" FontSize="12.5"
                                 Padding="9,7" IsEnabled="{Binding CheckForUpdates}"
                                 Text="{Binding UpdateFeedUrl, UpdateSourceTrigger=LostFocus}"
                                 Background="{DynamicResource WindowBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" />
                    </Grid>
                    <Button Style="{StaticResource GhostButton}" Width="Auto" HorizontalAlignment="Left" Margin="24,12,0,0"
                            Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.updates.check}"
                            Command="{Binding CheckUpdatesCommand}" />
                    <Rectangle Height="1" Margin="0,18,0,14" Fill="{DynamicResource SeparatorBrush}" />
                    <CheckBox IsChecked="{Binding SoftwareUpdateCheck}" Style="{StaticResource QuickToggle}"
                              Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.updates.software}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                    <CheckBox Margin="0,16,0,0" IsChecked="{Binding DriverUpdateCheck}" Style="{StaticResource QuickToggle}"
                              Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.updates.drivers}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.updates.checks.hint}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                               MaxWidth="620" HorizontalAlignment="Left" Margin="24,8,0,0" />
                    <TextBlock Text="{Binding UpdateStatusLine}" FontSize="11.5" Opacity="0.85" Margin="24,9,0,0"
                               TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- ESCLUSIONI -->
            <Border Margin="0,16,0,0" Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="24,18"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <c:NxIcon Kind="shield" Width="14" Height="14" Margin="0,0,9,0"
                                  VerticalAlignment="Center" Foreground="#36D4A8" />
                        <TextBlock FontSize="11" Typography.Capitals="AllSmallCaps" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.exclusions}" />
                    </StackPanel>
                    <TextBlock FontSize="11.5" Opacity="0.8" Margin="0,6,0,12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.excl.hint}" />

                    <ListBox x:Name="ExclList" Height="180" ItemsSource="{Binding Exclusions}"
                             SelectedItem="{Binding SelectedExclusion}"
                             Background="Transparent" BorderThickness="1"
                             BorderBrush="{DynamicResource CardBorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource GhostButton}"
                                Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.excl.addfolder}"
                                Command="{Binding AddFolderCommand}" />
                        <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.excl.addfile}"
                                Command="{Binding AddFileCommand}" />
                        <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=set.excl.remove}"
                                Command="{Binding RemoveCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
