<UserControl x:Class="NexusOptimizer.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
             xmlns:s="clr-namespace:NexusOptimizer.App.Services">
    <UserControl.Resources>
        <s:LocaleKeyConverter x:Key="Loc" />
        <s:LocaleKeyOfConverter x:Key="LocOf" />
        <Style x:Key="PremiumMonitorCard" TargetType="Border" BasedOn="{StaticResource ChartCard}">
            <Setter Property="Padding" Value="15" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="500" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource CardBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.window}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.subtitle}" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="9"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="4"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ListBox ItemsSource="{Binding RangeOptions}" SelectedValue="{Binding RangeId}" SelectedValuePath="Id"
                                 Background="Transparent" BorderThickness="0" HorizontalAlignment="Left">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Margin" Value="0,0,3,0" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bg" CornerRadius="7" Padding="12,6" Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" FontWeight="Medium" Text="{Binding LabelKey, Converter={StaticResource LocOf}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <CheckBox Grid.Column="2" IsChecked="{Binding Paused}" Style="{StaticResource QuickToggle}"
                              ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.pause.tip}"
                              VerticalAlignment="Center" Margin="18,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.pause}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.pause.sub}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </CheckBox>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="2,10,2,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Opacity="0.78" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.note}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource StateGreenBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.live}" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource StateGreenBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PremiumMonitorCard}" Margin="0,0,7,7">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="9" Background="#181DBDF2" Margin="0,0,9,0">
                                    <c:NxIcon Kind="cpuMini" Width="17" Height="17" Foreground="#1DBDF2" />
                                </Border>
                                <StackPanel><TextBlock Text="CPU" FontSize="12" FontWeight="SemiBold" Foreground="#1DBDF2" />
                                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.cpu.sub}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CpuCurrentText}" FontSize="24" FontWeight="SemiBold" Foreground="#1DBDF2" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <c:RadialGauge Width="96" Height="96" Value="{Binding CpuCurrent}" CenterText="{Binding CpuCurrentText}"
                                           SubText="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.usage}" Accent="#1DBDF2" RingThickness="6" CenterForeground="#1DBDF2" />
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <c:SparkGraph Series="{Binding CpuSeries}" FixedMax="100" Unit="percent" Accent="#1DBDF2"
                                              WindowSeconds="{Binding RangeWindowSeconds}" ShowYAxis="False" ShowXAxis="False" Smooth="True" />
                                <Grid Grid.Row="1" Margin="3,3,3,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.history}" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.samples}" HorizontalAlignment="Center" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.now}" HorizontalAlignment="Right" FontSize="8" Foreground="#1DBDF2" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PremiumMonitorCard}" Margin="7,0,0,7">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="9" Background="#18A64CEB" Margin="0,0,9,0">
                                    <c:NxIcon Kind="memory" Width="17" Height="17" Foreground="#A64CEB" />
                                </Border>
                                <StackPanel><TextBlock Text="RAM" FontSize="12" FontWeight="SemiBold" Foreground="#A64CEB" />
                                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.ram.sub}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding RamCurrentText}" FontSize="24" FontWeight="SemiBold" Foreground="#A64CEB" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <c:RadialGauge Width="96" Height="96" Value="{Binding RamCurrent}" CenterText="{Binding RamCurrentText}"
                                           SubText="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.usage}" Accent="#A64CEB" RingThickness="6" CenterForeground="#A64CEB" />
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <c:SparkGraph Series="{Binding RamSeries}" FixedMax="100" Unit="percent" Accent="#A64CEB"
                                              WindowSeconds="{Binding RangeWindowSeconds}" ShowYAxis="False" ShowXAxis="False" Smooth="True" />
                                <Grid Grid.Row="1" Margin="3,3,3,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.history}" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.ram.tag}" HorizontalAlignment="Center" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.now}" HorizontalAlignment="Right" FontSize="8" Foreground="#A64CEB" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PremiumMonitorCard}" Margin="0,7,7,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="9" Background="#182F8CFF" Margin="0,0,9,0">
                                    <c:NxIcon Kind="disk" Width="17" Height="17" Foreground="#2F8CFF" />
                                </Border>
                                <StackPanel><TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.disk}" FontSize="12" FontWeight="SemiBold" Foreground="#2F8CFF" />
                                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.disk.sub}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DiskCurrentText}" FontSize="24" FontWeight="SemiBold" Foreground="#2F8CFF" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <c:RadialGauge Width="96" Height="96" Value="{Binding DiskCurrent}" CenterText="{Binding DiskCurrentText}"
                                           SubText="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.activity}" Accent="#2F8CFF" RingThickness="6" CenterForeground="#2F8CFF" />
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <c:SparkGraph Series="{Binding DiskSeries}" FixedMax="100" Unit="percent" Accent="#2F8CFF"
                                              WindowSeconds="{Binding RangeWindowSeconds}" ShowYAxis="False" ShowXAxis="False" Smooth="True" />
                                <Grid Grid.Row="1" Margin="3,3,3,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.history}" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.disk.tag}" HorizontalAlignment="Center" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.now}" HorizontalAlignment="Right" FontSize="8" Foreground="#2F8CFF" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PremiumMonitorCard}" Margin="7,7,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="9" Background="#1816C7C9" Margin="0,0,9,0">
                                    <c:NxIcon Kind="globe" Width="17" Height="17" Foreground="#16C7C9" />
                                </Border>
                                <StackPanel><TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.net}" FontSize="12" FontWeight="SemiBold" Foreground="#16C7C9" />
                                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.net.sub}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding NetCurrentText}" FontSize="24" FontWeight="SemiBold" Foreground="#16C7C9" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="96" Height="96">
                                <Ellipse Stroke="{DynamicResource SeparatorBrush}" StrokeThickness="6" />
                                <Ellipse Stroke="#16C7C9" StrokeThickness="2" Opacity="0.72" Margin="8" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <c:NxIcon Kind="globe" Width="28" Height="28" Foreground="#16C7C9" />
                                    <TextBlock Text="LIVE" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="#16C7C9" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <c:SparkGraph Series="{Binding NetSeries}" Unit="bytesPerSecond" Accent="#16C7C9"
                                              WindowSeconds="{Binding RangeWindowSeconds}" ShowYAxis="False" ShowXAxis="False" Smooth="True" />
                                <Grid Grid.Row="1" Margin="3,3,3,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.history}" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.download}" HorizontalAlignment="Center" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=perf.now}" HorizontalAlignment="Right" FontSize="8" Foreground="#16C7C9" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
