<UserControl x:Class="NexusOptimizer.App.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:NexusOptimizer.App.Services"
             xmlns:c="clr-namespace:NexusOptimizer.App.Controls">
    <UserControl.Resources>
        <s:LocaleKeyConverter x:Key="Loc" />
        <Style x:Key="PremiumToolCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=tools.title}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=tools.subtitle}"
                               FontSize="12" Margin="1,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="12" Padding="12,7"
                        Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource StateGreenBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=tools.count}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding OpenCommand}" Style="{StaticResource PremiumToolCard}"
                                Height="180" Margin="0,0,12,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid Width="46" Height="46">
                                        <Border CornerRadius="13" Background="{DynamicResource AccentSoftBrush}" />
                                        <Border CornerRadius="13" BorderBrush="{Binding IconBrush}" BorderThickness="1" Opacity="0.42" />
                                        <c:NxIcon Kind="{Binding IconKind}" Foreground="{Binding IconBrush}" Width="25" Height="25" />
                                    </Grid>
                                    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            CornerRadius="8" Padding="7,4" Background="{DynamicResource WindowBackgroundBrush}">
                                        <TextBlock Text="{Binding Category}" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{Binding IconBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           Margin="0,13,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="2" Text="{Binding Detail}" FontSize="10.5" LineHeight="15"
                                           Margin="0,5,2,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=tools.open}" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{Binding IconBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="{Binding IconBrush}" />
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Margin="0,4,12,0" Padding="16,13" CornerRadius="12"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="11" Background="#1834C759" Margin="0,0,12,0">
                        <c:NxIcon Kind="shield" Width="20" Height="20" Foreground="{DynamicResource StateGreenBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=tools.controlled}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=tools.note}"
                                   FontSize="10" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=tools.safemode}" FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource StateGreenBrush}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
