<UserControl x:Class="NexusOptimizer.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
             xmlns:s="clr-namespace:NexusOptimizer.App.Services">

    <UserControl.Resources>
        <s:LocaleKeyConverter x:Key="Loc" />
        <s:BoolToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="RestoreCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20,18" />
        </Style>

        <Style x:Key="ChangeRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="16,14" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RestoreCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="24" Height="24">
                            <Border x:Name="Box" CornerRadius="7" Background="{DynamicResource WindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" />
                            <Path x:Name="Tick" Data="M 6 12 L 10 16 L 18 7" Stroke="White"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1160" Margin="0,0,4,18">
            <!-- Intestazione -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="27" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="1,4,0,0" MaxWidth="760"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"
                        Padding="14,9" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <c:NxIcon Kind="scan" Width="15" Height="15" Margin="0,0,8,0"
                                  Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.scan.button}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Hero: stato complessivo -->
            <Border Style="{StaticResource RestoreCard}" Padding="0" Margin="0,0,0,14" ClipToBounds="True">
                <Grid>
                    <Border CornerRadius="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#263B82F6" Offset="0" />
                                <GradientStop Color="#147C3AED" Offset="0.58" />
                                <GradientStop Color="#0834C759" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="22,19">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="58" Height="58" Margin="0,0,16,0">
                            <Border CornerRadius="17" Background="#223B82F6" BorderBrush="#663B82F6" BorderThickness="1" />
                            <c:NxIcon Kind="restoreCenter" Width="31" Height="31" Foreground="#75B6FF" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding HeroCountText}" FontSize="25" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding HeroStatusText}" FontSize="14" Margin="9,8,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ChangesStatus}" FontSize="11.5" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SystemCoreCountText}" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource StateGreenBrush}" />
                            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.metric.systemcore}"
                                       FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Rectangle Grid.Column="3" Width="1" Height="34" Margin="18,0"
                                   Fill="{DynamicResource SeparatorBrush}" />
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DetectedCountText}" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource StateYellowBrush}" />
                            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.metric.detected}"
                                       FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Le due opzioni richieste -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource RestoreCard}" BorderBrush="#4434C759">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="45" Height="45" CornerRadius="13" Background="#1834C759" BorderBrush="#3D34C759" BorderThickness="1">
                                <c:NxIcon Kind="undoShield" Width="24" Height="24" Foreground="{DynamicResource StateGreenBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="13,1,0,0">
                                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.own.title}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.own.badge}"
                                           FontSize="9.5" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource StateGreenBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding SystemCoreCountText}" FontSize="25" FontWeight="Bold"
                                       VerticalAlignment="Top" Foreground="{DynamicResource StateGreenBrush}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.own.detail}"
                                   FontSize="11.5" LineHeight="17" Margin="0,14,0,16" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Click="RestoreAllSystemCoreClicked"
                                IsEnabled="{Binding CanRestoreSystemCore}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <c:NxIcon Kind="undo" Width="15" Height="15" Margin="0,0,8,0" Foreground="White" />
                                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.own.action}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource RestoreCard}" BorderBrush="#44E6A23C">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="45" Height="45" CornerRadius="13" Background="#18E6A23C" BorderBrush="#3DE6A23C" BorderThickness="1">
                                <c:NxIcon Kind="windowsRestore" Width="24" Height="24" Foreground="{DynamicResource StateYellowBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="13,1,0,0">
                                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.detected.title}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.detected.badge}"
                                           FontSize="9.5" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource StateYellowBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding DetectedCountText}" FontSize="25" FontWeight="Bold"
                                       VerticalAlignment="Top" Foreground="{DynamicResource StateYellowBrush}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.detected.detail}"
                                   FontSize="11.5" LineHeight="17" Margin="0,14,0,16" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Row="2" Style="{StaticResource GhostButton}" Click="RestoreSelectedWindowsClicked"
                                IsEnabled="{Binding CanRestoreRecommended}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <c:NxIcon Kind="windowsRestore" Width="15" Height="15" Margin="0,0,8,0"
                                          Foreground="{DynamicResource StateYellowBrush}" />
                                <TextBlock Text="{Binding RecommendedButtonText}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Stato variato dopo l'applicazione: escluso dal ripristino globale -->
            <Border Visibility="{Binding HasChangedItems, Converter={StaticResource BoolVis}}"
                    Background="#14FF5A5F" BorderBrush="#44FF5A5F" BorderThickness="1"
                    CornerRadius="11" Padding="13,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <c:NxIcon Kind="warning" Width="18" Height="18" Margin="0,0,10,0" Foreground="{DynamicResource StateRedBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.changed.notice}"
                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding ChangedCountText}" FontSize="13" FontWeight="SemiBold"
                               Margin="12,0,0,0" Foreground="{DynamicResource StateRedBrush}" />
                </Grid>
            </Border>

            <!-- Modifiche attive -->
            <Grid Margin="2,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.active.title}"
                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.active.legend}"
                           FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>

            <Border Style="{StaticResource RestoreCard}" Padding="24" Margin="0,0,0,8"
                    Visibility="{Binding HasNoActiveChanges, Converter={StaticResource BoolVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="16" Background="#1834C759">
                        <c:NxIcon Kind="check" Width="25" Height="25" Foreground="{DynamicResource StateGreenBrush}" />
                    </Border>
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.empty.title}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.empty.detail}"
                               FontSize="11" Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding ActiveChanges}"
                          Visibility="{Binding HasActiveChanges, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ChangeRow}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="43" Height="43" CornerRadius="12" Margin="0,0,13,0"
                                        Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{Binding Accent}" BorderThickness="1">
                                    <c:NxIcon Kind="{Binding IconKind}" Width="22" Height="22" Foreground="{Binding Accent}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Border Margin="10,0,0,0" Padding="7,3" CornerRadius="7"
                                                Background="{DynamicResource WindowBackgroundBrush}">
                                            <TextBlock Text="{Binding StateText}" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{Binding Accent}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="0,4,12,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding SourceText}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{Binding Accent}" />
                                    <TextBlock Text="{Binding MetaText}" FontSize="9.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <CheckBox Grid.Column="3" Style="{StaticResource RestoreCheck}" Margin="8,0,12,0"
                                          VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Visibility="{Binding CanSelectRecommended, Converter={StaticResource BoolVis}}" />
                                <Button Grid.Column="4" Style="{StaticResource GhostButton}" Padding="12,7"
                                        Click="RestoreChangeClicked" Content="{Binding ActionText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Cronologia pulizie cifrate, mantenuta come terzo livello di sicurezza -->
            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=restore.history.title}"
                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,22,0,10" />
            <Border Style="{StaticResource RestoreCard}" Padding="17,13">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:NxIcon Kind="lock" Width="17" Height="17" Margin="0,0,9,0" Foreground="{DynamicResource AccentBrush}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding PrivacyNote}" FontSize="9.5" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=hist.restore}"
                                IsEnabled="{Binding CanUndo}" Click="UndoClicked" />
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                             Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="0,13,0,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Padding="13,10" CornerRadius="9" Background="{DynamicResource WindowBackgroundBrush}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="145" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CategoriesText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SummaryText}" FontSize="10" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DateText}" FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="10.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
