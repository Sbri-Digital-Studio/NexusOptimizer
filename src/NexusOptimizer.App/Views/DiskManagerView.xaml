<UserControl x:Class="NexusOptimizer.App.Views.DiskManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:NexusOptimizer.App.Services"
             xmlns:c="clr-namespace:NexusOptimizer.App.Controls">

    <UserControl.Resources>
        <s:LocaleKeyConverter x:Key="Loc" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Disk Manager" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=disk.subtitle}"
                               FontSize="12" Margin="1,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=disk.preview}" Command="{Binding CleanCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                    <Button Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=disk.settings}" Command="{Binding OpenStorageSettingsCommand}"
                            Style="{StaticResource GhostButton}" Margin="0,0,10,0" />
                    <Button Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=ui.refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Status}" Margin="1,14,0,10" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ItemsControl ItemsSource="{Binding Volumes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Background="{DynamicResource CardBrush}" CornerRadius="12"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18,15">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="125" /></Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <c:NxIcon Kind="disk" Width="25" Height="25" Foreground="{Binding StateBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Format}" FontSize="9.5" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,22,0">
                                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=disk.usedspace}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding UsedText}" FontSize="13" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding FreeText, StringFormat={}{0} liberi}" FontSize="10.5" Margin="0,2,0,0" Foreground="{Binding StateBrush}" />
                                </StackPanel>
                                <c:RadialGauge Grid.Column="3" Width="70" Height="70" RingThickness="5"
                                               Value="{Binding UsedPercent}" CenterText="{Binding UsedPercentText}"
                                               SubText="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=disk.used}" Accent="#34C759" AnimationsEnabled="False"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Margin="0,6,0,0" Padding="18" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12"
                    Visibility="{Binding EmptyStateVisibility}">
                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=disk.empty}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
            </Border>
            <Border Margin="0,12,0,0" Padding="16,13" CornerRadius="11"
                    Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <c:NxIcon Kind="shield" Width="22" Height="22" Foreground="{DynamicResource StateGreenBrush}" Margin="0,0,11,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=disk.protected.title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=disk.protected.note}"
                                   FontSize="10" Margin="0,3,12,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=disk.scannow}" Command="{Binding CleanCommand}"
                            Style="{StaticResource GhostButton}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
