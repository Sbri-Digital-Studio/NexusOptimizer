<UserControl x:Class="NexusOptimizer.App.Views.CleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:NexusOptimizer.App.Services"
             xmlns:c="clr-namespace:NexusOptimizer.App.Controls">

    <UserControl.Resources>
        <s:LocaleKeyConverter x:Key="Loc" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Left">
            <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding PageSub}" FontSize="13" Margin="1,4,0,16"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

            <Border Background="{DynamicResource CardBrush}" CornerRadius="14"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}"
                                VerticalAlignment="Top" Margin="0,1,14,0">
                            <c:NxIcon Kind="broom" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding LblRecover}" FontSize="11" Typography.Capitals="AllSmallCaps"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding RecoverableText}" FontSize="34" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,2" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="590" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=clean.cancel.btn}"
                                Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding BtnAnalyze}"
                                Command="{Binding AnalyzeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,16,0,0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding DryRun}" VerticalAlignment="Center"
                              Style="{StaticResource QuickToggle}" Margin="0,0,14,0"
                              ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=clean.dryrun.tip}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding BtnDry}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding DryRunNote}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="{Binding BtnClean}"
                                IsEnabled="{Binding CanRun}" Click="RunClicked" Margin="0,0,8,0"
                                ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=clean.dryrun.run.tip}" />
                        <Button Style="{StaticResource PrimaryButton}" Background="{DynamicResource StateRedBrush}"
                                Content="{Binding BtnDelete}" IsEnabled="{Binding CanDelete}"
                                Click="DeleteClicked" ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=clean.delete.tip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=clean.categories}" FontSize="11" Typography.Capitals="AllSmallCaps"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,22,0,10" />
            <ListBox ItemsSource="{Binding Categories}" Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" Style="{StaticResource QuickToggle}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" AutomationProperties.Name="Seleziona categoria" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding AdminNotice}" FontSize="10.5"
                                                   Margin="8,0,0,0" Foreground="{DynamicResource StateYellowBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LevelText}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Width="108" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Files, StringFormat={}{0} elementi}" FontSize="10.5"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Ellipse Grid.Column="3" Width="9" Height="9" Margin="16,0,2,0"
                                         Fill="{Binding LevelBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=clean.local.note}"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,8,0,20" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
