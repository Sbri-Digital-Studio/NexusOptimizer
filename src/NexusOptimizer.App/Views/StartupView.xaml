<UserControl x:Class="NexusOptimizer.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:NexusOptimizer.App.Services">
    <UserControl.Resources>
        <s:LocaleKeyConverter x:Key="Loc" />
        <Style x:Key="StartupSearch" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1180" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource CardBrush}" CornerRadius="13" Padding="18,14"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=startup.title}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#FFB454" />
                    <TextBlock Text="{Binding Status}" FontSize="11.5" Margin="0,5,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBox Grid.Column="1" Style="{StaticResource StartupSearch}" Margin="16,0,12,0"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=startup.search.tip}" />
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=ui.refresh}"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="14,8" CornerRadius="8"
                Background="{DynamicResource AccentSoftBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="115" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=startup.col.name}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" />
                <TextBlock Grid.Column="1" Text="PUBLISHER" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" />
                <TextBlock Grid.Column="2" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=startup.col.source}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" />
                <TextBlock Grid.Column="3" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=startup.col.startup}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" />
                <TextBlock Grid.Column="4" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=startup.col.process}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" />
                <TextBlock Grid.Column="5" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=startup.col.access}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" />
            </Grid>
        </Border>

        <ListBox Grid.Row="2" Margin="0,6,0,12" ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Row" Padding="14,9" CornerRadius="7" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="115" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Publisher}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                    ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=startup.col.startup.tip}">
                            <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="10.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=startup.col.process.tip}">
                            <Ellipse Width="7" Height="7" Fill="{Binding RuntimeBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RuntimeText}" Foreground="{Binding RuntimeBrush}" FontSize="10.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="5" Text="{Binding AccessText}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10.5" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Background="{DynamicResource CardBrush}" CornerRadius="13" Padding="18,14"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Selected.Name, TargetNullValue=Seleziona una voce di avvio}"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Selected.Command, TargetNullValue=Il comando originale verrà mostrato qui.}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5"
                               TextWrapping="Wrap" Margin="0,6,20,0" MaxHeight="44" />
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=startup.note}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,7,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding ActionLabel}"
                        IsEnabled="{Binding CanToggle}" Click="ToggleClicked" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
