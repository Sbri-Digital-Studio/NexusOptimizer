<UserControl x:Class="NexusOptimizer.App.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
             xmlns:s="clr-namespace:NexusOptimizer.App.Services">

    <UserControl.Resources>
        <s:BoolToVisibilityConverter x:Key="BoolVis" />
        <s:LocaleKeyConverter x:Key="Loc" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,12">

            <!-- ============================ INTESTAZIONE ============================ -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="14"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <c:PcTowerIcon Width="86" Height="96" Margin="0,-4,18,0" VerticalAlignment="Top" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HeroTitle}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding HeroSubtitle}" FontSize="12.5" Margin="1,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding PageSub}" FontSize="10.5" Margin="1,7,0,0" TextWrapping="Wrap"
                                       Opacity="0.75" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"
                                    Padding="14,8" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <c:NxIcon Kind="history" Width="14" Height="14" Margin="0,0,8,0"
                                              Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding RefreshLabel}" VerticalAlignment="Center" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding Status}" FontSize="9.5" Margin="0,8,2,0" MaxWidth="240"
                                       TextAlignment="Right" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Sintesi hardware: un riquadro per componente principale -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Highlights}" Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,10,0" Padding="13,11" CornerRadius="11"
                                        Background="{DynamicResource WindowBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,11,0"
                                                Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <c:NxIcon Kind="{Binding IconKind}" Width="18" Height="18"
                                                      Foreground="{Binding Accent}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="8.8"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Value}" FontSize="11.5" FontWeight="Medium"
                                                       Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="34"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- ============================== DETTAGLIO ============================== -->
            <ItemsControl ItemsSource="{Binding Sections}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="18,15"
                                Margin="0,0,12,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="10" Margin="0,0,12,0"
                                            Background="{DynamicResource WindowBackgroundBrush}">
                                        <c:NxIcon Kind="{Binding IconKind}" Width="17" Height="17"
                                                  Foreground="{Binding Accent}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Caption}" FontSize="10" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasCaption, Converter={StaticResource BoolVis}}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="118" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" FontSize="11" Margin="0,0,14,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                                           FontWeight="Medium" TextAlignment="Right" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16,12"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:NxIcon Kind="shield" Width="20" Height="20" Margin="0,0,11,0" VerticalAlignment="Top"
                              Foreground="{DynamicResource StateGreenBrush}" />
                    <TextBlock Grid.Column="1" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=pc.footer.note}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
