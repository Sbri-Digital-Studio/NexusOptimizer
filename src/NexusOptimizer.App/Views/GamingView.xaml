<UserControl x:Class="NexusOptimizer.App.Views.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
             xmlns:s="clr-namespace:NexusOptimizer.App.Services">

    <UserControl.Resources>
        <s:BoolToVisibilityConverter x:Key="BoolVis" />
        <s:LocaleKeyConverter x:Key="Loc" />

        <!-- Checkbox della lista app: quadrato con segno di spunta vettoriale. -->
        <Style x:Key="AppCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Border x:Name="Box" CornerRadius="5" BorderThickness="1.4"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource CardBorderBrush}" />
                            <c:NxIcon x:Name="Tick" Kind="check" Width="12" Height="12"
                                      Foreground="#FFFFFF" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,10">

            <!-- HERO: stato reale della sessione + comandi -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="14"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}"
                                VerticalAlignment="Top">
                            <c:NxIcon Kind="gamepad" Width="30" Height="30" Foreground="{DynamicResource AccentBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StateTitle}" FontSize="21" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border Margin="12,2,0,0" Padding="9,3" CornerRadius="7" VerticalAlignment="Center"
                                        Background="{DynamicResource WindowBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding ModeLevelText}" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{Binding StateBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StateDetail}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.session.duration}" FontSize="8.5" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SessionDuration}" FontSize="26" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Misure reali della sessione -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.ram.recovered}" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding FreedText}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource StateGreenBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource StatTile}">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.apps.closed}" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ClosedText}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource StatTile}">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.memory.compacted}" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding TrimmedText}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource StatTile}">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.ram.free}" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding AvailableNow}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Comandi -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.activate}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ActivateCommand}" Height="42"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.activate.tip}" />
                        <Button Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.deactivate}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding DeactivateCommand}" Height="42"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.rescan}" Height="42"
                                Style="{StaticResource GhostButton}" Command="{Binding ScanCommand}" />
                        <Button Grid.Column="2" Margin="10,0,0,0" Content="{Binding RestoreButtonText}" Height="42"
                                Style="{StaticResource GhostButton}" Command="{Binding RestoreAppsCommand}"
                                ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.reopen.tip}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Telemetria live -->
            <Border Margin="0,10,0,0" Background="{DynamicResource CardBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.now}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,0,18,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding CpuNow}" FontSize="15" FontWeight="SemiBold" Foreground="#1DBDF2" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="RAM" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding RamNow}" FontSize="15" FontWeight="SemiBold" Foreground="#A64CEB" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBlock Text="GPU" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding GpuNow}" FontSize="15" FontWeight="SemiBold" Foreground="#6BD93D" />
                    </StackPanel>
                    <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="10" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" TextAlignment="Right" ToolTip="{Binding Status}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- App in background rilevate -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.apps.title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectionText}" FontSize="10" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.apps.recommended}" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="10"
                                        Command="{Binding SelectRecommendedCommand}" />
                                <Button Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.apps.none}" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="10"
                                        Margin="7,0,0,0" Command="{Binding SelectNoneCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Margin="0,10,0,6" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.apps.note}" />

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Apps}" MinHeight="240">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="9"
                                            Background="{DynamicResource WindowBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource AppCheckBox}" IsChecked="{Binding IsSelected}" />
                                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Margin="11,0,10,0"
                                                    Background="{DynamicResource AccentSoftBrush}">
                                                <c:NxIcon Kind="{Binding IconKind}" Width="16" Height="16"
                                                          Foreground="{Binding CategoryBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding ProcessName}" FontSize="9" Margin="8,2,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Note}" FontSize="9.5" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding MemoryText}" FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding CategoryText}" FontSize="8.5" HorizontalAlignment="Right"
                                                           Foreground="{Binding CategoryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Azioni e resoconto -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.actions.title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.actions.sub}"
                                       FontSize="10" Margin="0,3,0,10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <CheckBox Style="{StaticResource QuickToggle}" Margin="0,0,0,9" IsChecked="{Binding CloseBackgroundApps}"
                                      Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.act.closeapps}" FontSize="11.5" />
                            <CheckBox Style="{StaticResource QuickToggle}" Margin="0,0,0,9" IsChecked="{Binding HighPerformancePowerPlan}"
                                      Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.act.power}" FontSize="11.5" />
                            <CheckBox Style="{StaticResource QuickToggle}" Margin="0,0,0,9" IsChecked="{Binding DisableGameDvr}"
                                      Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.act.gamedvr}" FontSize="11.5" />
                            <CheckBox Style="{StaticResource QuickToggle}" Margin="0,0,0,9" IsChecked="{Binding EnableWindowsGameMode}"
                                      Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.act.gamemode}" FontSize="11.5" />
                            <CheckBox Style="{StaticResource QuickToggle}" Margin="0,0,0,9" IsChecked="{Binding PrioritizeForegroundGame}"
                                      Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.act.priority}" FontSize="11.5" />
                            <CheckBox Style="{StaticResource QuickToggle}" Margin="0,0,0,9" IsChecked="{Binding TrimBackgroundMemory}"
                                      Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.act.memory}" FontSize="11.5" />
                            <CheckBox Style="{StaticResource QuickToggle}" Margin="0,0,0,9" IsChecked="{Binding SuspendIndexingServices}"
                                      IsEnabled="{Binding ServicesAvailable}" Content="{Binding ServicesLabel}" FontSize="11.5" />
                            <CheckBox Style="{StaticResource QuickToggle}" IsChecked="{Binding AllowForceClose}"
                                      IsEnabled="{Binding ForceCloseAvailable}" Content="{Binding ForceCloseLabel}" FontSize="11.5" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0" Background="{DynamicResource CardBrush}" CornerRadius="12"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.report.title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.report.sub}" FontSize="10" Margin="0,3,0,8"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding Report}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,9,0"
                                                     Fill="{Binding StateBrush}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="9.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Margin="0,10,0,0" Background="{DynamicResource CardBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:NxIcon Kind="shield" Width="22" Height="22" Foreground="{DynamicResource StateGreenBrush}"
                              Margin="0,0,11,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="10.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=gam.footer.note}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
