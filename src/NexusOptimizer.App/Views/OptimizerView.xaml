<UserControl x:Class="NexusOptimizer.App.Views.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
             xmlns:s="clr-namespace:NexusOptimizer.App.Services">

    <UserControl.Resources>
        <s:BoolToVisibilityConverter x:Key="BoolVis" />
        <s:LocaleKeyConverter x:Key="Loc" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,12">

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Optimizer" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.lead}"
                               FontSize="12" Margin="1,5,20,0" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"
                        VerticalAlignment="Top" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <c:NxIcon Kind="history" Width="14" Height="14" Margin="0,0,8,0"
                                  Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.rescan}" VerticalAlignment="Center" FontSize="11.5" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="14"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16,14">
                <StackPanel>
                    <Grid Margin="2,0,2,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.list.title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.list.sub}" FontSize="10.5" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.col.benefit}" FontSize="9" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.col.risk}" FontSize="9" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.col.action}" FontSize="9" VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.col.include}" FontSize="9" VerticalAlignment="Bottom"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>

                    <Border Margin="2,0,2,12" Padding="11,8" CornerRadius="9"
                            Background="{DynamicResource AccentSoftBrush}">
                        <StackPanel Orientation="Horizontal">
                            <c:NxIcon Kind="shield" Width="14" Height="14" Margin="0,0,9,0"
                                      Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding LevelSummary}" FontSize="10.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Margin="0,0,0,6" Padding="12,10"
                                        Background="{DynamicResource WindowBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="240" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Border CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" />
                                                <c:NxIcon Kind="{Binding IconKind}" Width="19" Height="19" Foreground="{Binding Accent}" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                                                             Fill="{Binding StateBrush}" />
                                                    <TextBlock Text="{Binding StateText}" FontSize="9.5" FontWeight="Medium"
                                                               Foreground="{Binding StateBrush}" />
                                                    <TextBlock Text="·" FontSize="9.5" Margin="6,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding MeasureText}" FontSize="9.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.label.benefit}" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Benefit}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BenefitBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.label.risk}" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Risk}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding RiskBrush}" />
                                            </StackPanel>

                                            <Border Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Padding="10,6" CornerRadius="8"
                                                    Background="{DynamicResource WindowBackgroundBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                    Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}"
                                                    ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.locked.tip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <c:NxIcon Kind="shield" Width="13" Height="13" Margin="0,0,7,0"
                                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding LockText}" FontSize="9.5" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <Button Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.revert}" Command="{Binding RevertCommand}"
                                                            Style="{StaticResource GhostButton}" Padding="9,4" FontSize="9.5"
                                                            Margin="9,0,0,0"
                                                            Visibility="{Binding CanRevertNow, Converter={StaticResource BoolVis}}"
                                                            ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.revert.locked.tip}" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding IsUnlocked, Converter={StaticResource BoolVis}}">
                                                <Button Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.apply}" Command="{Binding ApplyCommand}"
                                                        Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="10.5"
                                                        ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.apply.tip}" />
                                                <Button Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.revert}" Command="{Binding RevertCommand}"
                                                        Style="{StaticResource GhostButton}" Padding="10,6" FontSize="10.5" Margin="6,0,0,0"
                                                        Visibility="{Binding IsReversible, Converter={StaticResource BoolVis}}"
                                                        ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.revert.tip}" />
                                                <Button Content="›" AutomationProperties.Name="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.open.tip}"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding TargetId}" Style="{StaticResource GhostButton}"
                                                        FontSize="17" Padding="7,2" Margin="6,0,0,0"
                                                        ToolTip="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.open.tip}" />
                                            </StackPanel>

                                            <CheckBox Grid.Column="5" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource QuickToggle}" VerticalAlignment="Center"
                                                      Visibility="{Binding IsUnlocked, Converter={StaticResource BoolVis}}" />
                                        </Grid>

                                        <!-- Esito misurato dell'ultima esecuzione -->
                                        <Border Margin="46,9,0,0" Padding="10,7" CornerRadius="8"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <c:NxIcon Kind="check" Width="13" Height="13" Margin="0,0,8,0"
                                                          Foreground="{DynamicResource StateGreenBrush}" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding ResultText}" FontSize="10" TextWrapping="Wrap" MaxWidth="720"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{Binding PrepareButtonText}" Command="{Binding ApplySelectedCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Height="42" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="14,11" CornerRadius="11"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <c:NxIcon Kind="shield" Width="20" Height="20" Foreground="{DynamicResource StateGreenBrush}"
                              Margin="0,0,11,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Margin="0,5,0,0" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=opt.footer.note}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
