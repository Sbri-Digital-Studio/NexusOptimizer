<UserControl x:Class="NexusOptimizer.App.Views.PrivacyGuardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:NexusOptimizer.App.Services">

    <UserControl.Resources>
        <s:LocaleKeyConverter x:Key="Loc" />
    </UserControl.Resources>
    <StackPanel MaxWidth="1180" HorizontalAlignment="Left">
        <TextBlock Text="Privacy Guard" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=priv.subtitle}"
                   FontSize="12" Margin="1,4,0,16" Foreground="{DynamicResource TextSecondaryBrush}" />
        <UniformGrid Columns="2">
            <Border Margin="0,0,8,12" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="18"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=priv.telemetry}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TelemetryStatus}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{Binding TelemetryBrush}" />
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=priv.telemetry.note}"
                               FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Margin="8,0,0,12" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="18"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=priv.diagnostics}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=priv.localonly}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{DynamicResource StateGreenBrush}" />
                    <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=priv.diagnostics.note}"
                               FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>
        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="18"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=priv.store}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LocalDataPath}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=priv.opensettings}" Command="{Binding OpenCommand}" CommandParameter="nav.settings" Style="{StaticResource GhostButton}" />
                    <Button Content="{Binding Source={x:Static s:Locale.Live}, Path=Version, Converter={StaticResource Loc}, ConverterParameter=priv.opendiagnostics}" Command="{Binding OpenCommand}" CommandParameter="nav.diagnostics" Style="{StaticResource GhostButton}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
